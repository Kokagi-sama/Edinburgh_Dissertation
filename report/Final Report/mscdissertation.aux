\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces Detection performance of the three Pythia detectors under the three T5 mask-filling models. Left: AUROC. Right: PR-AUC. Performance rises monotonically with filler capacity for every detector, but the gain from T5-large to T5-3B is small, and T5-small collapses the large detectors to near the dashed chance line.}}{28}{figure.caption.13}\protected@file@percent }
\newlabel{fig:exp3_bars}{{6.1}{28}{Detection performance of the three Pythia detectors under the three T5 mask-filling models. Left: AUROC. Right: PR-AUC. Performance rises monotonically with filler capacity for every detector, but the gain from T5-large to T5-3B is small, and T5-small collapses the large detectors to near the dashed chance line}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces ROC curves (top row) and PR curves (bottom row) for each Pythia detector under the three T5 mask-filling models. The T5-small curves for the large detectors track the chance diagonal, whilst T5-3B sustains high precision across recall, showing that filler capacity governs whether the curvature signal survives.}}{29}{figure.caption.14}\protected@file@percent }
\newlabel{fig:exp3_curves}{{6.2}{29}{ROC curves (top row) and PR curves (bottom row) for each Pythia detector under the three T5 mask-filling models. The T5-small curves for the large detectors track the chance diagonal, whilst T5-3B sustains high precision across recall, showing that filler capacity governs whether the curvature signal survives}{figure.caption.14}{}}
\citation{kaplan2020scaling,hoffmann2022training}
\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces AUROC (left) and PR-AUC (right) as a function of mask-filling model parameter count for each Pythia detector. All curves rise steeply then flatten, making the diminishing returns explicit, and the detector gap narrows as capacity grows, showing that a faithful perturbation removes most of the detector-scale penalty.}}{30}{figure.caption.15}\protected@file@percent }
\newlabel{fig:exp3_scale_trend}{{6.3}{30}{AUROC (left) and PR-AUC (right) as a function of mask-filling model parameter count for each Pythia detector. All curves rise steeply then flatten, making the diminishing returns explicit, and the detector gap narrows as capacity grows, showing that a faithful perturbation removes most of the detector-scale penalty}{figure.caption.15}{}}
