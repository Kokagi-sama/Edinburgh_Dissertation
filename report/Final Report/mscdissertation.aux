\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces AUROC and PR-AUC for each perturbation strategy across the three Pythia detectors, with the generator fixed to SmolLM2-1.7B. Synonym substitution collapses every detector towards the dashed chance line, whilst random words and random tokens recover or exceed the semantic control, showing that statistical disruption suffices.}}{33}{figure.caption.16}\protected@file@percent }
\newlabel{fig:exp4_bars}{{7.1}{33}{AUROC and PR-AUC for each perturbation strategy across the three Pythia detectors, with the generator fixed to SmolLM2-1.7B. Synonym substitution collapses every detector towards the dashed chance line, whilst random words and random tokens recover or exceed the semantic control, showing that statistical disruption suffices}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces Progression of AUROC and PR-AUC across the four perturbation strategies for each Pythia detector, ordered from full semantic coherence to pure token noise. All three detectors trace the same V-shape, with the dip at synonyms and the recovery under statistical perturbations.}}{34}{figure.caption.17}\protected@file@percent }
\newlabel{fig:exp4_lines}{{7.2}{34}{Progression of AUROC and PR-AUC across the four perturbation strategies for each Pythia detector, ordered from full semantic coherence to pure token noise. All three detectors trace the same V-shape, with the dip at synonyms and the recovery under statistical perturbations}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces ROC curves (top row) and PR curves (bottom row) for each Pythia detector under the four perturbation strategies. The synonym curves track the chance diagonal whilst the statistical strategies match or exceed the semantic control, confirming that the curvature signal survives without semantic coherence.}}{34}{figure.caption.18}\protected@file@percent }
\newlabel{fig:exp4_curves}{{7.3}{34}{ROC curves (top row) and PR curves (bottom row) for each Pythia detector under the four perturbation strategies. The synonym curves track the chance diagonal whilst the statistical strategies match or exceed the semantic control, confirming that the curvature signal survives without semantic coherence}{figure.caption.18}{}}
