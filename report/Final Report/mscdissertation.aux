\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces AUROC scores across detector training steps for various generator models. Rows represent generative models and columns represent detector checkpoints, sorted by model size and training progression, and lighter cells indicate higher performance. Detection efficacy is inversely related to training duration: early checkpoints exceed 0.90 against most generators whilst fully converged checkpoints fall to or below chance, most severely for Pythia-1.4B.}}{23}{figure.caption.10}\protected@file@percent }
\newlabel{fig:exp2_auroc}{{5.1}{23}{AUROC scores across detector training steps for various generator models. Rows represent generative models and columns represent detector checkpoints, sorted by model size and training progression, and lighter cells indicate higher performance. Detection efficacy is inversely related to training duration: early checkpoints exceed 0.90 against most generators whilst fully converged checkpoints fall to or below chance, most severely for Pythia-1.4B}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces PR-AUC scores across detector training steps for various generator models, with the same layout as Figure \ref {fig:exp2_auroc}. The gradient is identical and more severe, confirming that full convergence collapses precision and recall, especially for the largest detector.}}{24}{figure.caption.11}\protected@file@percent }
\newlabel{fig:exp2_prauc}{{5.2}{24}{PR-AUC scores across detector training steps for various generator models, with the same layout as Figure \ref {fig:exp2_auroc}. The gradient is identical and more severe, confirming that full convergence collapses precision and recall, especially for the largest detector}{figure.caption.11}{}}
