\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Mean detection performance as a function of detector training step, averaged across the 13 generators. All three scales start near 0.94 at 1k steps, but the degradation grows with parameter count: by 143k steps Pythia-1.4B falls to about 0.55 (near the dashed chance line), Pythia-410M to about 0.77, and Pythia-70M only to about 0.92, showing that overfitting, not scale alone, drives the decline.}}{25}{figure.caption.12}\protected@file@percent }
\newlabel{fig:exp2_checkpoint_trend}{{5.3}{25}{Mean detection performance as a function of detector training step, averaged across the 13 generators. All three scales start near 0.94 at 1k steps, but the degradation grows with parameter count: by 143k steps Pythia-1.4B falls to about 0.55 (near the dashed chance line), Pythia-410M to about 0.77, and Pythia-70M only to about 0.92, showing that overfitting, not scale alone, drives the decline}{figure.caption.12}{}}
