\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces AUROC scores for distinguishing human text from various generator models. Rows represent generative models and columns represent detector models, both sorted from largest to smallest parameter count, and lighter cells indicate higher performance. Detection efficacy is inversely related to detector size: the smallest detectors (right) exceed 0.90 against most generators whilst the largest (left) fall to or below chance.}}{17}{figure.caption.6}\protected@file@percent }
\newlabel{fig:exp1_auroc}{{4.1}{17}{AUROC scores for distinguishing human text from various generator models. Rows represent generative models and columns represent detector models, both sorted from largest to smallest parameter count, and lighter cells indicate higher performance. Detection efficacy is inversely related to detector size: the smallest detectors (right) exceed 0.90 against most generators whilst the largest (left) fall to or below chance}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces PR-AUC scores for distinguishing human text from various generator models, with the same layout as Figure \ref {fig:exp1_auroc}. The gradient is identical, confirming that smaller detectors maintain high precision and recall whilst the largest detectors collapse.}}{18}{figure.caption.7}\protected@file@percent }
\newlabel{fig:exp1_prauc}{{4.2}{18}{PR-AUC scores for distinguishing human text from various generator models, with the same layout as Figure \ref {fig:exp1_auroc}. The gradient is identical, confirming that smaller detectors maintain high precision and recall whilst the largest detectors collapse}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Mean detection performance as a function of detector parameter count, averaged across the 13 generators. Both AUROC and PR-AUC decline monotonically as detector size increases and fall to or below the chance level (dashed line) at 1.7 billion parameters, confirming that the inverse relationship is an aggregate property of the matrix.}}{19}{figure.caption.8}\protected@file@percent }
\newlabel{fig:exp1_scale_trend}{{4.3}{19}{Mean detection performance as a function of detector parameter count, averaged across the 13 generators. Both AUROC and PR-AUC decline monotonically as detector size increases and fall to or below the chance level (dashed line) at 1.7 billion parameters, confirming that the inverse relationship is an aggregate property of the matrix}{figure.caption.8}{}}
\citation{guo2017calibration,kadavath2022language}
\citation{belkin2019reconciling}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Within-family and cross-family mean AUROC (left) and PR-AUC (right) by detector scale. Within-family performance exceeds cross-family performance at every scale for both metrics, but all four curves decline monotonically and collapse together at 1.7 billion parameters, showing that the inverse relationship is not driven by self-detection. Pythia detectors appear only in the cross-family curves because Pythia models were not used as generators.}}{20}{figure.caption.9}\protected@file@percent }
\newlabel{fig:exp1_family_split}{{4.4}{20}{Within-family and cross-family mean AUROC (left) and PR-AUC (right) by detector scale. Within-family performance exceeds cross-family performance at every scale for both metrics, but all four curves decline monotonically and collapse together at 1.7 billion parameters, showing that the inverse relationship is not driven by self-detection. Pythia detectors appear only in the cross-family curves because Pythia models were not used as generators}{figure.caption.9}{}}
